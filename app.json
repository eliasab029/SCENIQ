{
  "expo": {
    "name": "SCENIQ",
    "slug": "sceniq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sceniq",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./public/favicon-48.png",
      "name": "SCENIQ",
      "shortName": "SCENIQ",
      "lang": "de",
      "themeColor": "#0A0A0C",
      "backgroundColor": "#0A0A0C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "SCENIQ braucht Zugriff auf deine Fotos, um passende Musik für deine Story zu finden.",
          "cameraPermission": "SCENIQ braucht die Kamera, um direkt ein Foto für deine Story aufzunehmen.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0C"
  }
}
